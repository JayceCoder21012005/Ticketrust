  "components": {
    "schemas": {
      "AvailabilityResponse": {
        "required": [
          "serverNow",
          "version",
          "unavailable",
          "tiers"
        ],
        "type": "object",
        "properties": {
          "serverNow": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "unavailable": {
            "type": "array",
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          "tiers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TierRemaining"
            }
          }
        }
      },
      "AvatarUploadRequest": {
        "required": [
          "contentType",
          "size"
        ],
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string"
          },
          "size": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "ConfirmEmailCommand": {
        "required": [
          "userId",
          "token"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "EventCategory": {
        "required": [
          "slug",
          "name"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "EventDetail": {
        "required": [
          "id",
          "slug",
          "title",
          "description",
          "category",
          "lineup",
          "coverImageUrl",
          "startsAt",
          "endsAt",
          "status",
          "isSoldOut",
          "venue",
          "tiers",
          "phases"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "lineup": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coverImageUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/EventStatus"
          },
          "isSoldOut": {
            "type": "boolean"
          },
          "venue": {
            "$ref": "#/components/schemas/VenueInfo"
          },
          "tiers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TierInfo"
            }
          },
          "phases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PhaseInfo"
            }
          }
        }
      },
      "EventPage": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventSummary"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "EventStatus": {
        "enum": [
          "Draft",
          "Published",
          "Ended",
          "Cancelled"
        ]
      },
      "EventSummary": {
        "required": [
          "id",
          "slug",
          "title",
          "category",
          "startsAt",
          "venueName",
          "city",
          "coverImageUrl",
          "priceFrom",
          "nextSaleOpensAt",
          "isOnSale",
          "isSoldOut"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "venueName": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "coverImageUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "priceFrom": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "nextSaleOpensAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "isOnSale": {
            "type": "boolean"
          },
          "isSoldOut": {
            "type": "boolean"
          }
        }
      },
      "ForgotPasswordCommand": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "LoginCommand": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "required": [
          "accessToken",
          "expiresAt",
          "user"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserAccount"
          }
        }
      },
      "PhaseInfo": {
        "required": [
          "id",
          "name",
          "opensAt",
          "closesAt",
          "queueEnabled",
          "maxTicketsPerUser",
          "requiresAccessCode"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "opensAt": {
            "type": "string",
            "format": "date-time"
          },
          "closesAt": {
            "type": "string",
            "format": "date-time"
          },
          "queueEnabled": {
            "type": "boolean"
          },
          "maxTicketsPerUser": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "requiresAccessCode": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
