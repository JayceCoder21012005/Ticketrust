{
  "name": "ticketrush-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "api:gen": "openapi-typescript openapi/ticketrush-api.json -o src/lib/api/schema.d.ts",
