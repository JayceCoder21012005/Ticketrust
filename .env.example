# Copy to .env on the server. Never commit the real file.
PUBLIC_HOST=tickets.example.com
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# >= 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=change-me-change-me-change-me-change-me
# Signs waiting-room admission tokens (spec 06), >= 32 chars and different from JWT_SIGNING_KEY.
ADMISSION_TOKEN_SIGNING_KEY=change-me-too-change-me-too-change-me-too
# Presale code pepper (spec 05), >= 32 chars, e.g. `openssl rand -hex 32`. Changing it invalidates existing codes.
ACCESS_CODE_PEPPER=change-me-change-me-change-me-change-me
# Cloudflare Turnstile (spec 12): the secret key for the api, the site key for the web build.
TURNSTILE_SECRET=change-me
TURNSTILE_SITE_KEY=change-me
# Payment webhook HMAC key (spec 08), >= 16 chars, e.g. `openssl rand -hex 32`. The mock gateway's pages and controls stay off in production.
PAYMENT_WEBHOOK_SECRET=change-me-change-me-change-me
EMAIL_FROM_ADDRESS=no-reply@example.com
# Web cache revalidation hook (POST /api/revalidate), e.g. `openssl rand -hex 32`
REVALIDATE_SECRET=change-me-change-me-change-me
REGISTRY=ghcr.io/your-org/ticketrush
TAG=latest
