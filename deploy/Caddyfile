{$PUBLIC_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# SignalR goes straight to the api: Next's standalone server does not proxy WebSocket upgrades (vercel/next.js#44209).
	handle /hubs/* {
		reverse_proxy api:8080
	}
	# Payment webhooks go straight to the api too (spec 08): the signature covers the exact body bytes, so no Next rewrite sits in between.
	# Measured through the rewrite: a body just over the 64 KB limit sometimes came back 502 instead of 413 (the api answers and closes while Next is still
	# writing, "Failed to proxy ... EPIPE"); a real provider would see a 5xx and retry.
	handle /api/v1/webhooks/* {
		reverse_proxy api:8080
	}
	reverse_proxy web:3000
}
