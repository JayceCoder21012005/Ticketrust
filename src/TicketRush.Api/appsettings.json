{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": { "Environment": "dev" },
  "Jwt": {
    "Issuer": "ticketrush-api",
    "Audience": "ticketrush-web",
    "AccessTokenMinutes": 10
  },
  "Payment": { "Provider": "Mock", "PaymentWindowMinutes": 8 },
  "Email": { "FromAddress": "no-reply@ticketrush.dev", "FromName": "TicketRush" },
  "Storage": { "Provider": "Local", "PublicBaseUrl": "http://localhost:3000/media" },
  "Queue": { "AdmissionRatePerSecond": 50, "MaxActiveShoppers": 500, "ShoppingWindowMinutes": 10, "PreQueueMinutes": 30 },
  "Holds": { "TtlSeconds": 480, "MaxSeatsPerHold": 8 },
  "RateLimits": { "GlobalPerIpPerMinute": 600, "LoginPerIpPerMinute": 10 },
  "Frontend": { "BaseUrl": "http://localhost:3000" },
  "Outbox": { "BatchSize": 100, "PollInterval": "00:00:01" }
}
